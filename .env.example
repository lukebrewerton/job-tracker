# Copy to .env for local development:  cp .env.example .env
# In production these are set as Render environment variables, never committed.
#
# Every variable the app reads is listed here with a placeholder value, added in the
# same change that introduces it.

# --- App ---
# Canonical origin this instance is served on. Requests arriving on any other host are
# redirected here (308). Required. Local dev: the FastAPI address.
PUBLIC_BASE_URL=http://localhost:8000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory holding the built frontend (Vite's dist/). Default suits local dev; the
# Docker image sets its own path.
STATIC_DIR=frontend/dist

# --- Local Postgres (docker compose, `make up`) ---
# Dev-only credentials for the local container; production uses Neon's DATABASE_URL.
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=jobtracker
