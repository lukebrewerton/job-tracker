# Copy to .env for local development:  cp .env.example .env
# In production these are set as Render environment variables, never committed.
#
# Every variable the app reads is listed here with a placeholder value, added in the
# same change that introduces it.

# --- App ---
# Canonical origin this instance is served on. Requests arriving on any other host are
# redirected here (308). Required. Local dev: the FastAPI address.
PUBLIC_BASE_URL=http://localhost:8000

# Postgres connection string. Required. `postgresql://` or `postgresql+psycopg://` both
# work. It MUST use a role that is neither a superuser nor BYPASSRLS, or row-level
# security is skipped — migrations refuse to run otherwise.
#   Local dev: the APP_DB_* role below (keep them in step).
#   Production: Neon's *direct* (non-pooled) URL for the dedicated `jobtracker_app` role,
#   with sslmode=require — never the default `neondb_owner`, which has BYPASSRLS.
DATABASE_URL=postgresql://jobtracker_app:change-me-local-only@localhost:5432/jobtracker

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory holding the built frontend (Vite's dist/). Default suits local dev; the
# Docker image sets its own path.
STATIC_DIR=frontend/dist

# --- Local Postgres (docker compose, `make up`) ---
# Dev-only credentials for the local container; production uses Neon's DATABASE_URL.
# POSTGRES_USER is the container's superuser: admin only, never used by the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin-local-only
POSTGRES_DB=jobtracker
# The role the app connects as (created on first start by docker/postgres/initdb).
APP_DB_USER=jobtracker_app
APP_DB_PASSWORD=change-me-local-only
